<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Action -->
    <record id="action_dsa_details" model="ir.actions.act_window">
        <field name="name">DSA Details Sheet</field>
        <field name="res_model">dsa.details</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- List View -->
    <record id="view_dsa_details_list" model="ir.ui.view">
        <field name="name">dsa.details.list</field>
        <field name="model">dsa.details</field>
        <field name="arch" type="xml">

            <list string="DSA Details">
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="po_number"/>
                <field name="month"/>
                <field name="travel_from"/>
                <field name="travel_to"/>
            </list>

        </field>
    </record>

    <!-- Form View -->
    <record id="view_dsa_details_form" model="ir.ui.view">
        <field name="name">dsa.details.form</field>
        <field name="model">dsa.details</field>
        <field name="arch" type="xml">

            <form string="DSA Details">

                <sheet>

                    <!-- Row 1 -->
                    <group col="2">

                        <group>
                            <field name="employee_id"/>
                        </group>

                        <group>
                            <field name="job_id" readonly="1"/>
                        </group>

                    </group>

                    <!-- Row 2 -->
                    <group col="2">

                        <group>
                            <field name="po_number"/>
                        </group>

                        <group>
                            <field name="month"/>
                        </group>

                    </group>

                    <!-- Row 3 -->
                    <group col="2">

                        <group>
                            <field name="travel_from" options="{'max_date':'today'}"/>
                        </group>

                        <group>
                            <field name="travel_to" options="{'max_date':'today'}"/>
                        </group>

                    </group>

                    <!-- Row 4 -->
                    <group col="2">

                        <group>
                            <field name="travel_location_from"/>
                        </group>

                        <group>
                            <field name="travel_location_to"/>
                        </group>

                    </group>

                    <!-- Row 5 -->
                    <group>
                        <field name="travel_purpose"/>
                    </group>

                    <!-- Dynamic Travel Lines -->
                    <group string="Accommodation Details">

                        <field name="line_ids">

                            <list>
                                <field name="dsa_date_from" options="{'max_date':'today'}"/>
                                <field name="dsa_date_to" options="{'max_date':'today'}"/>
                                <field name="place_of_stay"/>
                            </list>

                            <form string="Accommodation Detail">

                                <group col="2">

                                    <group>
                                        <field name="dsa_date_from"/>
                                    </group>

                                    <group>
                                        <field name="dsa_date_to"/>
                                    </group>

                                </group>

                                <group>
                                    <field name="place_of_stay"/>
                                </group>
                                <group>
                                    <field name="hotel_provided"/>
                                </group>
                                <group>
                                    <field name="lunch_provided"/>
                                </group>

                            </form>

                        </field>

                    </group>

                </sheet>

            </form>

        </field>
    </record>

</odoo>