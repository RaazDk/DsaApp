<form string="DSA Details">

    <sheet>

        <!-- Header -->
        <div class="oe_title">
            <h1>
                <field name="employee_id" placeholder="Select Employee"/>
            </h1>
            <div class="text-muted">
                Daily Subsistence Allowance Request
            </div>
        </div>

        <!-- Travel Information -->
        <group string="Travel Information" col="4">

            <field name="job_id" readonly="1"/>
            <field name="month"/>

            <field name="po_number"/>
            <field name="travel_purpose"/>

            <field name="travel_from"/>
            <field name="travel_to"/>

            <field name="travel_location_from"/>
            <field name="travel_location_to"/>

        </group>

        <notebook>

            <page string="Accommodation">

                <field name="line_ids">

                    <list editable="bottom">
                        <field name="dsa_date_from"/>
                        <field name="dsa_date_to"/>
                        <field name="place_of_stay"/>
                    </list>

                    <form>

                        <group col="2">
                            <field name="dsa_date_from"/>
                            <field name="dsa_date_to"/>
                        </group>

                        <group>
                            <field name="place_of_stay"/>
                        </group>

                    </form>

                </field>

            </page>

        </notebook>

    </sheet>

</form>