<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Action -->
    <record id="action_dsa_details" model="ir.actions.act_window">
        <field name="name">DSA Details Sheet</field>
        <field name="res_model">dsa.details</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- List View -->
    <record id="view_dsa_details_list" model="ir.ui.view">
        <field name="name">dsa.details.list</field>
        <field name="model">dsa.details</field>
        <field name="arch" type="xml">
            <list string="DSA Details">
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="tr_number"/>
                <field name="po_number"/>
                <field name="month"/>
                <field name="travel_from"/>
                <field name="travel_to"/>
                <field name="total_travel_days" string="Days"/>
                <field name="conf_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_dsa_details_form" model="ir.ui.view">
        <field name="name">dsa.details.form</field>
        <field name="model">dsa.details</field>
        <field name="arch" type="xml">

            <form string="DSA Details">
                 <header>
                    <button string="Print Claim Sheet"
                        type="action"
                        name="%(dsa.action_report_dsa_claimsheet)d"
                        class="btn-secondary"/>
                 </header>
                <sheet>

                    <field name="lines_remaining" invisible="1"/>
                    <field name="total_travel_days" invisible="1"/>

                    <group col="2">
                        <group><field name="employee_id"/></group>
                        <group><field name="job_id" readonly="1"/></group>

                    </group>

                    <group col="2">
                        <group><field name="tr_number"/> </group>
                        <group><field name="po_number"/></group>
                    </group>

                    <group col="2">
                        <group><field name="month"/></group>
                        <group><field name="travel_from"/></group>
                    </group>

                    <group col="2">
                        <group><field name="travel_to"/></group>
                        <group><field name="travel_location_from"/></group>
                    </group>

                    <group col="2">
                        <group><field name="travel_location_to"/></group>
                        <group><field name="travel_purpose"/></group>
                    </group>
                    <group>
                        <group><field name="conf_id" readonly="1"/></group>

                    </group>

                    <!--
                        Warning: all days filled
                        role="alert" required by Odoo 19 accessibility rules
                    -->
                    <div class="alert alert-warning mb-2"
                         role="alert"
                         invisible="lines_remaining != 0 or not travel_from or not travel_to">
                        All travel days have been covered. Adding more lines will be blocked on save.
                    </div>

                    <!--
                        Info: days remaining
                        role="status" for non-interrupting informational message
                    -->
                    <div class="alert alert-info mb-2"
                         role="status"
                         invisible="lines_remaining == 0 or not travel_from or not travel_to">
                        <field name="lines_remaining" nolabel="1" class="fw-bold"/> of
                        <field name="total_travel_days" nolabel="1"/> day(s) remaining.
                    </div>

                    <group string="Accommodation Details">
                        <!--
                            readonly when travel dates not yet entered:
                              - hides Add a line button
                              - prevents editing before travel window is defined
                            min_rows="0": removes Odoo's default blank placeholder rows
                        -->
                        <field name="line_ids"
                               readonly="not travel_from or not travel_to">
                            <list editable="bottom" min_rows="0">
                                <field name="dsa_date_from" format="%d-%m-%Y"/>
                                <field name="dsa_date_to"   format="%d-%m-%Y"/>
                                <field name="place_of_stay"/>
                                <field name="hotel_provided"/>
                                <field name="lunch_provided"/>
                            </list>
                        </field>
                    </group>

                </sheet>
            </form>

        </field>
    </record>

</odoo>