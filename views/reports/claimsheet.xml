<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- Report Action -->
        <record id="action_report_dsa_claimsheet" model="ir.actions.report">
            <field name="name">DSA Claim Sheet</field>
            <field name="model">dsa.details</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">dsa.report_dsa_claimsheet</field>
            <field name="report_file">dsa.report_dsa_claimsheet</field>
            <field name="binding_model_id" ref="model_dsa_details"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_dsa_claimsheet">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <div style="font-family: Arial, sans-serif; padding: 20px;">

                        <!-- Centered company logo and name -->
                        <div style="text-align:center; margin-bottom:6px;">
                            <img t-att-src="'/web/image/res.company/%s/logo' % doc.env.company.id"
                                 style="max-height:80px; max-width:220px; display:block; margin:0 auto;"/>
                            <div style="font-size:13px; font-weight:bold; margin-top:4px;">
                                <t t-out="doc.env.company.name"/>
                            </div>
                            <div style="font-size:11px;">
                                <t t-out="doc.env.company.country_id.name or ''"/>
                            </div>
                        </div>

                        <div class="page">

                            <style>
                                /* Force center the external layout header */
                                #wkhtmltopdf_sep_header,
                                .header,
                                .o_report_layout_standard > div:first-child,
                                .o_report_layout > div:first-child {
                                    text-align: center !important;
                                }
                                /* Target Odoo's company header block */
                                .o_company_and_address,
                                .o_company_and_address td,
                                .o_company_and_address tr {
                                    text-align: center !important;
                                    display: block;
                                    width: 100%;
                                }
                                /* Logo itself */
                                img.o_company_logo,
                                .o_company_logo img,
                                [class*="logo"] img,
                                img[class*="logo"] {
                                    display: block !important;
                                    margin: 0 auto !important;
                                }
                                /* The top header table Odoo generates */
                                .header > table {
                                    width: 100%;
                                }
                                .header > table td {
                                    text-align: center !important;
                                    vertical-align: middle !important;
                                }
                                /* Override any left-aligned cells in header */
                                .page-header td,
                                .page-header th {
                                    text-align: center !important;
                                }
                                .dsa-table {
                                    width: 100%;
                                    border-collapse: collapse;
                                    font-size: 11px;
                                }
                                .dsa-table td, .dsa-table th {
                                    border: 1px solid #000;
                                    padding: 4px 6px;
                                    vertical-align: middle;
                                }
                                .dsa-table th {
                                    text-align: center;
                                    font-weight: bold;
                                    background-color: #f0f0f0;
                                }
                                .dsa-header-table {
                                    width: 100%;
                                    border-collapse: collapse;
                                    font-size: 11px;
                                    margin-bottom: 6px;
                                }
                                .dsa-header-table td {
                                    padding: 2px 4px;
                                    border: none;
                                }
                                .text-center { text-align: center; }
                                .text-right  { text-align: right; }
                                .text-left   { text-align: left; }
                                .office-use  { text-decoration: underline; font-weight: bold; }
                                .in-npr      { text-align: right; font-style: italic; font-size: 10px; }
                                .total-row td { font-weight: bold; }
                            </style>

                            <!-- Title -->
                            <h4 class="text-center" style="margin-bottom:2px;">
                                DSA Calculation for SSA Holders
                            </h4>
                            <p class="text-center office-use" style="margin-bottom:8px;">
                                OFFICE USE ONLY
                            </p>

                            <!-- Header Info -->
                            <table class="dsa-header-table">
                                <tr>
                                    <td style="width:50%">
                                        Name :&#160;<t t-out="doc.employee_id.name"/>
                                    </td>
                                    <td style="width:50%">
                                        Duty Station:
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        Position:&#160;<t t-out="doc.job_id.name or ''"/>
                                    </td>
                                    <td>
                                        For the month of:&#160;
                                        <t t-out="dict(doc.fields_get(['month'])['month']['selection'])[doc.month]"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>TR No:&#160;<t t-out="doc.tr_number"/></td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td>PO#&#160;<t t-out="doc.po_number"/></td>
                                    <td></td>
                                </tr>
                            </table>

                            <!-- in NPR label -->
                            <p class="in-npr" style="margin-bottom:2px;">in NPR</p>

                            <!-- Main DSA Table -->
                            <table class="dsa-table">
                                <thead>
                                    <tr>
                                        <th style="width:5%">S.N.</th>
                                        <th style="width:22%">PLACE OF NIGHT HALT</th>
                                        <th style="width:20%">DATES</th>
                                        <th style="width:8%">NO. OF DAYS</th>
                                        <th style="width:10%">PER DIEM RATE</th>
                                        <th style="width:12%">CLAIMED PER DIEM</th>
                                        <th style="width:13%">AMOUNT</th>
                                        <th style="width:10%">FIN</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    <!-- Filled lines from accommodation data -->
                                    <t t-foreach="doc.line_ids" t-as="line">

                                        <t t-set="line_days"
                                           t-value="(line.dsa_date_to - line.dsa_date_from).days + 1
                                                    if line.dsa_date_from and line.dsa_date_to else 0"/>

                                        <t t-set="line_ded" t-value="0.0"/>
                                        <t t-if="line.hotel_provided"
                                           t-set="line_ded"
                                           t-value="line_ded + (doc.conf_id.deduction_if_hotel_provided or 0.0)"/>
                                        <t t-if="line.lunch_provided"
                                           t-set="line_ded"
                                           t-value="line_ded + (doc.conf_id.deduction_if_lunch_provided or 0.0)"/>
                                        <t t-set="line_ded" t-value="min(line_ded, 100.0)"/>

                                        <t t-set="line_rate" t-value="doc.conf_id.dsa_rate or 0.0"/>
                                        <t t-set="claimed_rate"
                                           t-value="line_rate * (1.0 - line_ded / 100.0)"/>
                                        <t t-set="line_amount"
                                           t-value="line_days * claimed_rate"/>

                                        <tr>
                                            <td class="text-center"><t t-out="line_index + 1"/></td>
                                            <td><t t-out="line.place_of_stay or ''"/></td>
                                            <td class="text-center">
                                                <t t-out="line.dsa_date_from"
                                                   t-options='{"widget": "date", "format": "d MMM yyyy"}'/>
                                                to
                                                <t t-out="line.dsa_date_to"
                                                   t-options='{"widget": "date", "format": "d MMM yyyy"}'/>
                                                <br/>
                                                Last Day:
                                                <t t-out="line.dsa_date_to"
                                                   t-options='{"widget": "date", "format": "d MMM yyyy"}'/>
                                            </td>
                                            <td class="text-center"><t t-out="line_days"/></td>
                                            <td class="text-right"><t t-out="'%.2f' % line_rate"/></td>
                                            <td class="text-right"><t t-out="'%.2f' % claimed_rate"/></td>
                                            <td class="text-right"><t t-out="'%.2f' % line_amount"/></td>
                                            <td></td>
                                        </tr>
                                    </t>



                                </tbody>

                                <!-- Total Row -->
                                <tfoot>
                                    <t t-set="grand_total" t-value="0.0"/>
                                    <t t-foreach="doc.line_ids" t-as="tl">
                                        <t t-set="tdays"
                                           t-value="(tl.dsa_date_to - tl.dsa_date_from).days + 1
                                                    if tl.dsa_date_from and tl.dsa_date_to else 0"/>
                                        <t t-set="tded" t-value="0.0"/>
                                        <t t-if="tl.hotel_provided"
                                           t-set="tded"
                                           t-value="tded + (doc.conf_id.deduction_if_hotel_provided or 0.0)"/>
                                        <t t-if="tl.lunch_provided"
                                           t-set="tded"
                                           t-value="tded + (doc.conf_id.deduction_if_lunch_provided or 0.0)"/>
                                        <t t-set="tded" t-value="min(tded, 100.0)"/>
                                        <t t-set="trate" t-value="doc.conf_id.dsa_rate or 0.0"/>
                                        <t t-set="grand_total"
                                           t-value="grand_total + tdays * trate * (1.0 - tded / 100.0)"/>
                                    </t>
                                    <tr class="total-row">
                                        <td colspan="6" class="text-center">
                                            TOTAL DSA PAYABLE
                                        </td>
                                        <td class="text-right">
                                            <t t-out="'%.2f' % grand_total"/>
                                        </td>
                                        <td></td>
                                    </tr>
                                </tfoot>

                            </table>

                            <!-- Summary Footer Table -->
                            <table class="dsa-table" style="margin-top:16px;">
                                <tr>
                                    <td colspan="6" style="border:none;"></td>
                                    <td colspan="2" class="in-npr" style="border:none; text-align:right; font-style:italic;">
                                        in NPR
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="6" style="border:none; padding-left:8px;">
                                        Daily Allowance
                                    </td>
                                    <td class="text-right">
                                        <t t-set="grand_total2" t-value="0.0"/>
                                        <t t-foreach="doc.line_ids" t-as="tl2">
                                            <t t-set="tdays2"
                                               t-value="(tl2.dsa_date_to - tl2.dsa_date_from).days + 1
                                                        if tl2.dsa_date_from and tl2.dsa_date_to else 0"/>
                                            <t t-set="tded2" t-value="0.0"/>
                                            <t t-if="tl2.hotel_provided"
                                               t-set="tded2"
                                               t-value="tded2 + (doc.conf_id.deduction_if_hotel_provided or 0.0)"/>
                                            <t t-if="tl2.lunch_provided"
                                               t-set="tded2"
                                               t-value="tded2 + (doc.conf_id.deduction_if_lunch_provided or 0.0)"/>
                                            <t t-set="tded2" t-value="min(tded2, 100.0)"/>
                                            <t t-set="trate2" t-value="doc.conf_id.dsa_rate or 0.0"/>
                                            <t t-set="grand_total2"
                                               t-value="grand_total2 + tdays2 * trate2 * (1.0 - tded2 / 100.0)"/>
                                        </t>
                                        <t t-out="'%.2f' % grand_total2"/>
                                    </td>
                                    <td style="border:none;"></td>
                                </tr>
                                <tr>
                                    <td colspan="6" style="border:none; padding-left:8px;">
                                        Travel Cost and Misc. Expenses
                                    </td>
                                    <td class="text-right">-</td>
                                    <td class="text-right">-</td>
                                </tr>
                                <tr style="font-weight:bold;">
                                    <td colspan="6" class="text-center" style="font-weight:bold;">
                                        Total Payable
                                    </td>
                                    <td colspan="2" class="text-right" style="font-weight:bold;">
                                        NPR&#160;<t t-out="'%.2f' % grand_total2"/>
                                    </td>
                                </tr>
                            </table>

                            <!-- Deduction Notes — no % formatting, all literal text -->
                            <div style="margin-top:10px; font-size:10px;">
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <t t-if="line.hotel_provided or line.lunch_provided">
                                        <div>
                                            <t t-out="line.dsa_date_from"
                                               t-options='{"widget": "date", "format": "d MMM yyyy"}'/>
                                            -
                                            <t t-out="line.dsa_date_to"
                                               t-options='{"widget": "date", "format": "d MMM yyyy"}'/>
                                            ;
                                            <t t-if="line.hotel_provided">
                                                <t t-out="int(doc.conf_id.deduction_if_hotel_provided or 0)"/>% deduction for accommodation provided by organizer<t t-if="line.lunch_provided">; </t>
                                            </t>
                                            <t t-if="line.lunch_provided">
                                                <t t-out="int(doc.conf_id.deduction_if_lunch_provided or 0)"/>% deduction for lunch provided
                                            </t>
                                        </div>
                                    </t>
                                </t>
                            </div>

<!--                            &lt;!&ndash; Signature Block &ndash;&gt;-->
<!--                            <table style="width:100%; margin-top:40px; border-collapse:collapse;">-->
<!--                                <tr>-->
<!--                                    <td style="width:33%; border:none; text-align:center; padding-top:30px;">-->
<!--                                        <div style="border-top:1px solid #000; padding-top:4px;">-->
<!--                                            Claimant Signature-->
<!--                                        </div>-->
<!--                                        <div><t t-out="doc.employee_id.name"/></div>-->
<!--                                    </td>-->
<!--                                    <td style="width:33%; border:none;"></td>-->
<!--                                    <td style="width:33%; border:none; text-align:center; padding-top:30px;">-->
<!--                                        <div style="border-top:1px solid #000; padding-top:4px;">-->
<!--                                            Authorised Signature-->
<!--                                        </div>-->
<!--                                    </td>-->
<!--                                </tr>-->
<!--                            </table>-->

                        </div>
                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>