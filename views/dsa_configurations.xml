<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Action -->
    <record id="action_dsa_conf" model="ir.actions.act_window">
        <field name="name">DSA Configuration</field>
        <field name="res_model">dsa.conf</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- List View -->
    <record id="view_dsa_conf_list" model="ir.ui.view">
        <field name="name">dsa.conf.list</field>
        <field name="model">dsa.conf</field>
        <field name="arch" type="xml">
            <list string="DSA Configuration">
                <field name="year"/>
                <field name="dsa_rate"/>
                <field name="deduction_if_lunch_provided"/>
                <field name="deduction_if_hotel_provided"/>
                <field name="issue_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_dsa_conf_form" model="ir.ui.view">
        <field name="name">dsa.conf.form</field>
        <field name="model">dsa.conf</field>
        <field name="arch" type="xml">
            <form string="DSA Configuration">

                <sheet>

                    <group col="2">

                        <group>
                            <field name="year"/>
                            <field name="dsa_rate"/>
                        </group>

                        <group>
                            <field name="deduction_if_lunch_provided"/>
                            <field name="deduction_if_hotel_provided"/>
                        </group>
                        <group>
                             <field name="issue_date"/>
                        </group>

                    </group>

                </sheet>

            </form>
        </field>
    </record>

</odoo>